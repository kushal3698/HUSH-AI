# Real-Time WebSocket Server URL (leave empty for automatic local connection: ws://localhost:3001)
# For production deployments (e.g. Render / Railway / VPS):
# VITE_WS_URL=wss://your-hush-backend.onrender.com
VITE_WS_URL=

# Optional Firebase Configuration (leave empty to use built-in WebSocket & local storage)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional Google AI Studio Gemini API Key
VITE_GEMINI_API_KEY=
